# Backend integration — point at the Laravel API and flip the mock switch off.
# All service calls go through src/services/http.ts; no component changes needed.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=true

# Google Maps JS SDK (§4.3). With a key set, every map (browse map, home
# teaser, exposé location) renders real Google Maps; leave empty to use the
# keyless demo canvas (OSM/Esri raster tiles). Get a key: Google Cloud console
# → "Maps JavaScript API". Optional map ID for custom Cloud styling.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
